{
  "info": {
    "_postman_id": "smartlogix-collection-v1",
    "name": "SmartLogix API",
    "description": "Colección completa de endpoints de la plataforma SmartLogix.\n\nUsa el API Gateway como punto de entrada único (puerto 8080).\n\n**Flujo de inicio:**\n1. Ejecutar `POST /api/auth/login` — el token se guarda automáticamente en la variable `token`.\n2. El resto de peticiones usan `Authorization: Bearer {{token}}` de forma automática.\n\n**Variables de entorno disponibles:**\n- `baseUrl` → URL base del gateway\n- `token` → JWT de autenticación\n- `clienteId`, `productoId`, `pedidoId`, `proveedorId`, `pagoId`, `envioId` → IDs de ejemplo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string",
      "description": "URL base del API Gateway. Cambia a http://localhost:808X para acceso directo al microservicio."
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT obtenido tras POST /api/auth/login. Se rellena automáticamente con el script del login."
    },
    {
      "key": "clienteId",
      "value": "uuid-del-cliente",
      "type": "string"
    },
    {
      "key": "productoId",
      "value": "uuid-del-producto",
      "type": "string"
    },
    {
      "key": "pedidoId",
      "value": "uuid-del-pedido",
      "type": "string"
    },
    {
      "key": "proveedorId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "pagoId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "envioId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "usuarioId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth (ms-auth · 8081)",
      "description": "Autenticación y autorización. Las rutas /api/auth/** son públicas — no requieren token.",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('token', json.token);",
                  "    console.log('Token guardado: ' + json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@smartlogix.com\",\n  \"password\": \"contraseña123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Autentica al usuario y devuelve un JWT. El script de test guarda automáticamente el token en la variable `token`."
          }
        },
        {
          "name": "Registro",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nuevo@smartlogix.com\",\n  \"password\": \"contraseña123\",\n  \"rol\": \"USER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "registro"]
            },
            "description": "Registra un nuevo usuario. Roles disponibles: USER, ADMIN."
          }
        },
        {
          "name": "Validar Token",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/validar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "validar"]
            },
            "description": "Valida si el token JWT del header es válido. Devuelve true/false."
          }
        }
      ]
    },
    {
      "name": "Clientes (ms-clientes · 8082)",
      "description": "Gestión de clientes. Todos los endpoints requieren JWT.",
      "item": [
        {
          "name": "Listar clientes",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes"]
            }
          }
        },
        {
          "name": "Crear cliente",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"rut\": \"12345678-9\",\n  \"email\": \"juan@empresa.cl\",\n  \"telefono\": \"+56912345678\",\n  \"direccion\": \"Av. Providencia 1234, Santiago\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/clientes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes"]
            },
            "description": "Nombre, RUT y email son obligatorios. El email y RUT deben ser únicos."
          }
        },
        {
          "name": "Obtener cliente por ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/{{clienteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes", "{{clienteId}}"]
            }
          }
        },
        {
          "name": "Actualizar cliente",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez Actualizado\",\n  \"rut\": \"12345678-9\",\n  \"email\": \"juan.nuevo@empresa.cl\",\n  \"telefono\": \"+56987654321\",\n  \"direccion\": \"Calle Nueva 456, Santiago\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/clientes/{{clienteId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes", "{{clienteId}}"]
            }
          }
        },
        {
          "name": "Pedidos de un cliente",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes/{{clienteId}}/pedidos",
              "host": ["{{baseUrl}}"],
              "path": ["api", "clientes", "{{clienteId}}", "pedidos"]
            },
            "description": "Obtiene los pedidos asociados a un cliente. Consulta ms-pedidos internamente via Feign."
          }
        }
      ]
    },
