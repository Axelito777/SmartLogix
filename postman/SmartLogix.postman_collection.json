    {
      "name": "Pedidos (ms-pedidos · 8084)",
      "description": "Gestión de pedidos. Al crear un pedido, orquesta automáticamente stock, pago, envío y notificación. Todos los endpoints requieren JWT.",
      "item": [
        {
          "name": "Listar pedidos",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
